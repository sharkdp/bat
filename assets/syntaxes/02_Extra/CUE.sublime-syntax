                0: punctuation.section.interpolation.end
              pop: true
            - include: whitespace
            - include: punctuation_option
            - include: expression
            - include: invalid_in_parens
        - match: \\####.
          scope: invalid.illegal
    - match: '###"""'
      captures:
        0: punctuation.definition.string.begin
      push:
        - meta_scope: meta.string
        - meta_content_scope: string.quoted.double-multiline
        - match: '"""###'
          captures:
            0: punctuation.definition.string.end
          pop: true
        - match: '\\###(?:"|/|\\|[abfnrtv]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'
          scope: constant.character.escape
        - match: '\\###(?:[0-7]{3}|x[0-9A-Fa-f]{2})'
          scope: invalid.illegal
        - match: \\###\(
          captures:
            0: punctuation.section.interpolation.begin
          push:
            - meta_scope: meta.interpolation
            - meta_content_scope: source.cue.embedded
            - match: \)
              captures:
                0: punctuation.section.interpolation.end
              pop: true
            - include: whitespace
            - include: punctuation_option
            - include: expression
            - include: invalid_in_parens
        - match: \\###$
          scope: constant.character.escape
        - match: \\###.
          scope: invalid.illegal
    - match: '###"'
      captures:
        0: punctuation.definition.string.begin
      push:
        - meta_scope: meta.string
        - meta_content_scope: string.quoted.double
        - match: '"###'
          captures:
            0: punctuation.definition.string.end
          pop: true
        - match: '\\###(?:"|/|\\|[abfnrtv]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'
          scope: constant.character.escape
        - match: '\\###(?:[0-7]{3}|x[0-9A-Fa-f]{2})'
          scope: invalid.illegal
        - match: \\###\(
          captures:
